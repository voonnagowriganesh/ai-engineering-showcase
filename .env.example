# Web3Forms access key -> https://web3forms.com (free, no signup backend required)
# Create a key with your email, paste it here as .env.local, then redeploy.
VITE_WEB3FORMS_KEY=your-access-key-here

# Umami analytics (optional) -> https://umami.is (free Hobby plan, cookie-free)
# Add the site in Umami, copy its Website ID here. Leave empty to disable.
VITE_UMAMI_WEBSITE_ID=
# Only needed if you self-host Umami; defaults to Umami Cloud.
VITE_UMAMI_SCRIPT_URL=
# Hostnames to count (comma-separated); visits on other hosts are ignored.
VITE_UMAMI_DOMAINS=
# The live values are committed in .env.production.

# Public site URL used for canonical/OG tags
VITE_SITE_URL=https://voonnagowriganesh.vercel.app
