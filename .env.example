# Copy to .env (or set these in your host's environment settings), then rebuild.
# Every value is optional: leave one empty and that feature simply stays off.

# Umami analytics: cookie-free visit counts and custom events
# (resume-download, project-open, github-click, cert-flip, contact-submit,
# social-click, email-click). Get the ID from Umami > Settings > Websites.
VITE_UMAMI_WEBSITE_ID=
# Optional: only needed for a self-hosted Umami. Defaults to Umami Cloud.
VITE_UMAMI_SCRIPT_URL=

# Web3Forms access key for the contact form (free at web3forms.com).
# This key is public by design. Without it, the form opens the visitor's
# email app with the message prefilled instead.
VITE_WEB3FORMS_KEY=

# Public site URL, e.g. https://your-site.netlify.app (no trailing slash).
# Used for the canonical link and absolute share-image URLs (LinkedIn,
# WhatsApp and X previews need absolute URLs).
VITE_SITE_URL=
