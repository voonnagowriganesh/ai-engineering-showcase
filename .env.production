# Production build settings (committed on purpose: these values are public by
# design — they appear in the page source of every site that uses them).

# Umami analytics website ID (cookie-free visit counts).
VITE_UMAMI_WEBSITE_ID=d7b20afe-6dd0-4c3c-9c04-6dc53db03236
# Web3Forms access key: contact-form messages are emailed to the inbox this
# key was created with. Public by design (it's sent from the browser).
VITE_WEB3FORMS_KEY=aa813d23-48d3-4405-87af-01c5f8f46470

# Only count visits on the live domain, so preview deploys and local
# testing never inflate the numbers. Comma-separate to add a custom domain.
VITE_UMAMI_DOMAINS=voonnagowriganesh.vercel.app
